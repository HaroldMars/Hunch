# Hunch backend API: the PRODUCTION variables to set on the API host.
# For local testing, backend/.env only needs NODE_ENV=development (no real keys): uploads stay local
# and emails are printed in the terminal.
# NEVER commit the real .env file: it is listed in .gitignore.

PORT=5000
NODE_ENV=production

# Public URLs (no trailing slash). Only these origins may call the API from a browser.
CLIENT_URL=https://app.hunch.ph
ADMIN_URL=https://admin.hunch.ph
API_URL=https://api.hunch.ph
# Optional: extra allowed origins, comma separated (e.g. a staging site)
EXTRA_ORIGINS=

# Required in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First developer account, created only when the database has no developer yet.
# If INITIAL_ADMIN_PASSWORD is empty, a random one is printed once in the server log.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Where the SQLite database lives (must be a persistent disk in production). Default: backend/data
DATA_DIR=

# Media storage. When set, every upload goes to Cloudinary and only the URL is stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hunch

# Outgoing email (SMTP). Used for verification codes, welcome / password-reset emails and
# Email Center messages to non-Hunch addresses. Gmail: use an App Password (Google Account > Security).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional
GOOGLE_CLIENT_ID=
ORS_API_KEY=

# Story music (optional). Free API key from https://freesound.org/apiv2/apply — without it the Music tool is hidden.
FREESOUND_API_KEY=
