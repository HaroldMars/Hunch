# Hunch client app. Copy to .env (local) or set these in the Vercel project "hunch-client".
# Only VITE_* values are exposed to the browser, so never put secrets here.
VITE_APP_NAME=Hunch
# Backend API (no trailing slash). Leave empty for local development: Vite proxies /api to localhost:5050.
VITE_API_URL=https://api.hunch.ph
# Sibling apps (used for "Open Admin Dashboard" / sign-in hand-over)
VITE_CLIENT_URL=https://app.hunch.ph
VITE_ADMIN_URL=https://admin.hunch.ph
# Map tiles (OpenStreetMap, free)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
