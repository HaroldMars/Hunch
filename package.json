{
  "name": "hunch",
  "private": true,
  "version": "0.3.0",
  "description": "Hunch - Social Mood & Team Engagement Platform",
  "workspaces": [
    "backend",
    "client",
    "admin"
  ],
  "scripts": {
    "dev": "concurrently -n client,admin -c cyan,yellow \"npm:dev -w client\" \"npm:dev -w admin\"",
    "seed:demo": "npm run seed:demo -w backend && npm run seed:v3 -w backend",
    "reset": "npm run reset -w backend",
    "build": "npm run build -w client && npm run build -w admin",
    "seed:v3": "npm run seed:v3 -w backend",
    "dev:backend": "npm run dev -w backend",
    "dev:client": "npm run dev -w client",
    "dev:admin": "npm run dev -w admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
